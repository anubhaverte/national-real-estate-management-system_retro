# Database Configuration
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=real_estate_system

# Security: Required strong secret key for signing JWT tokens (do not leave empty)
SECRET_KEY=generate-a-strong-random-secret-key-for-production

# CORS: Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500
